# ── Transcoder 音频解码服务 ──────────────────────────────
# 复制为 .env 后根据实际情况修改

# ── API ──
API_KEY=dev-key
PORT=8002

# ── Storage Service 地址 ──
STORAGE_URL=http://localhost:8001
STORAGE_API_KEY=

# ── Whisper ASR 配置 ──
# 模型选项: tiny, base, small, medium, large
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=auto

# ── Task Queue ──
# memory = 内存队列（默认）
# TASK_QUEUE=memory
MAX_CONCURRENT_TASKS=1
