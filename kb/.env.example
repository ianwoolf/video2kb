# ── API ────────────────────────────────────────────────────────────────
API_KEY=dev-key
HOST=0.0.0.0
PORT=8000

# ── Memgraph（图数据库）──────────────────────────────────────────────
ENABLE_GRAPH=true
MEMGRAPH_URI=bolt://memgraph:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── Qdrant（向量数据库）───────────────────────────────────────────────
ENABLE_VECTOR=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=video2kb

# ── Embedding 配置 ────────────────────────────────────────────────────
# local: 使用本地 bge-small-zh-v1.5 模型（推荐）
# zhipu: 使用智谱 API embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 智谱 API Key（可选，用于 embedding fallback 和 LLM）
ZAI_API_KEY=

# ── LlamaIndex RAG ───────────────────────────────────────────────────
ENABLE_LLAMAINDEX=true
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4-flash
