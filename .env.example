# ── video2kb 统一部署配置 ──────────────────────────────
# 此文件为 Part 1 和 Part 2 的共享配置
# 复制为 .env 后根据实际情况修改

# ── API Keys ──
ZAI_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=

# ── Part 1 配置 ──
WHISPER_MODEL=base
LLM_PROVIDER=zai
LLM_MODEL=glm-4.7
SPACY_MODEL=zh_core_web_sm

# ── Part 1 → Part 2 通信 ──
# Part 2 部署地址（Part 1 容器内访问）
DATA_SERVICE_URL=http://host.docker.internal:8000
DATA_SERVICE_API_KEY=

# ── Part 2 配置 ──
API_KEY=
API_PORT=8000

# ── Neo4j 配置 ──
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
