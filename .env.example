# ── video2kb 统一部署配置 ──────────────────────────────
# 此文件为 Pipeline 和 KB 的共享配置
# 复制为 .env 后根据实际情况修改

# ── API Keys ──
ZAI_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=

# ── Pipeline 配置 ──
WHISPER_MODEL=base
LLM_PROVIDER=zai
LLM_MODEL=glm-4.7
SPACY_MODEL=zh_core_web_sm

# ── Pipeline → KB 通信 ──
# KB 部署地址（Pipeline 容器内访问）
DATA_SERVICE_URL=http://host.docker.internal:8000
DATA_SERVICE_API_KEY=

# ── KB 配置 ──
API_KEY=
API_PORT=8000

# ── Neo4j 配置 ──
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
