# ── video2kb 统一部署配置 ──────────────────────────────
# 此文件为 Pipeline 和 KB 的共享配置
# 复制为 .env 后根据实际情况修改

# ── API Keys ──
ZAI_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=

# ── Pipeline 配置 ──
WHISPER_MODEL=base
LLM_PROVIDER=zai
LLM_MODEL=glm-4.7
SPACY_MODEL=zh_core_web_sm

# ── Pipeline → KB 通信 ──
# KB 部署地址（Pipeline 容器内访问）
DATA_SERVICE_URL=http://host.docker.internal:8000
DATA_SERVICE_API_KEY=

# ── KB 配置 ──
API_KEY=dev-key
API_PORT=8000

# ── Memgraph（图数据库）──────────────────────────────────────────
ENABLE_GRAPH=true
MEMGRAPH_URI=bolt://memgraph:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_UI_PORT=3000

# ── Qdrant（向量数据库）─────────────────────────────────────────
ENABLE_VECTOR=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=video2kb
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Embedding 配置 ─────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── LlamaIndex RAG ───────────────────────────────────────────
ENABLE_LLAMAINDEX=true
