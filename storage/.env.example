# ── Storage 物料存储服务 ──────────────────────────────
# 复制为 .env 后根据实际情况修改

# ── API ──
API_KEY=dev-key
PORT=8001

# ── Storage Backend ──
# local = 本地文件系统（默认）
# s3 = MinIO/S3（空实现，需扩展）
STORAGE_BACKEND=local
STORAGE_BASE_DIR=data/storage

# ── S3 / MinIO（仅当 STORAGE_BACKEND=s3 时）──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=video2kb
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
