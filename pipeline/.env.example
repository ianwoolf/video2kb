# ── Pipeline 采集分析服务 环境变量 ──

# API Keys（LLM 功能需要）
OPENAI_API_KEY=sk-xxx
ZAI_API_KEY=your_zhipu_api_key_here

# LLM 配置
LLM_PROVIDER=zai
LLM_MODEL=glm-4.7

# ── 外部服务地址（第三波新增）──
# Storage 物料存储服务
STORAGE_URL=http://localhost:8001
STORAGE_API_KEY=

# Transcoder 音频解码服务
TRANSCODER_URL=http://localhost:8002
TRANSCODER_API_KEY=

# KB 数据服务地址
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_API_KEY=

# Whisper 模型配置（仅本地 fallback 时使用，外部 Transcoder 服务不需要）
# 选项: tiny, base, small, medium, large
WHISPER_MODEL=base

# 报告输出格式
# 选项: markdown, word, both
DOC_FORMAT=markdown

# spaCy NLP 模型
SPACY_MODEL=zh_core_web_sm

# Hugging Face 镜像（中国大陆用户）
# HF_ENDPOINT=https://hf-mirror.com
